rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.uid is string &&
             data.displayName is string &&
             data.email is string;
    }

    function isValidCard(data, userId) {
      return data.id is string &&
             data.userId == userId &&
             data.title is string &&
             data.title.size() > 0 &&
             data.itch is string &&
             data.skeleton is string &&
             data.intuition is string &&
             data.branchDomain is string &&
             data.isSaved is bool &&
             data.recallStage is int;
    }

    function isValidThread(data, userId) {
      return data.id is string &&
             data.userId == userId &&
             data.cardId is string &&
             data.cardTitle is string &&
             data.lastMessage is string;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) && (request.resource == null || isValidUser(request.resource.data));

      match /cards/{cardId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidCard(request.resource.data, userId);
      }

      match /threads/{threadId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidThread(request.resource.data, userId);
      }
    }

    // Reject all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
